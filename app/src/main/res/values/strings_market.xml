    <string name="market_keys_brapi" translatable="false">brapi</string>
    <string name="market_keys_brapi_site" translatable="false">brapi.dev</string>
    <string name="market_keys_brapi_row">Brazilian stocks · brapi</string>
    <string name="market_keys_brapi_without">No key: only PETR4, VALE3, ITUB4 and MGLU3</string>
    <string name="market_keys_brapi_intro">Stocks, real estate funds, ETFs and BDRs from B3, with charts of up to 3 months on the free plan. Prices arrive about 30 minutes late.</string>
    <string name="market_keys_brapi_create">Free sign-up. PETR4, VALE3, ITUB4 and MGLU3 already work without a key.</string>
    <string name="market_keys_brapi_copy">In the brapi dashboard, copy your token.</string>

    <string name="market_keys_alpaca" translatable="false">Alpaca</string>
    <string name="market_keys_alpaca_site" translatable="false">alpaca.markets</string>
    <string name="market_keys_alpaca_key" translatable="false">Key</string>
    <string name="market_keys_alpaca_secret" translatable="false">Secret</string>
    <string name="market_keys_alpaca_row">US stocks · Alpaca</string>
    <string name="market_keys_alpaca_without">No key · price, pre-market and after hours, and charts</string>
    <string name="market_keys_alpaca_intro">US stocks: price, pre-market and after hours, and charts of every range. Free; prices arrive 15 minutes late.</string>
    <string name="market_keys_alpaca_create">Free, with email. No deposit and no real brokerage account needed: the paper trading account is enough.</string>
    <string name="market_keys_alpaca_copy">In the dashboard, under API Keys, tap Generate New Keys. Two parts appear, Key and Secret: copy one at a time. The Secret is shown only once.</string>

    <string name="market_keys_finnhub" translatable="false">Finnhub</string>
    <string name="market_keys_finnhub_site" translatable="false">finnhub.io</string>
    <string name="market_keys_finnhub_row">US stocks with no delay · Finnhub</string>
    <string name="market_keys_finnhub_without">Optional · real-time prices and company names</string>
    <string name="market_keys_finnhub_intro">US stocks during regular hours, with no delay, and the names of the companies. No charts on the free plan: those come from Alpaca.</string>
    <string name="market_keys_finnhub_create">Free, with email.</string>
    <string name="market_keys_finnhub_copy">The key is on the dashboard right after signing up.</string>

    <string name="market_keys_awesome" translatable="false">AwesomeAPI</string>
    <string name="market_keys_awesome_site" translatable="false">awesomeapi.com.br</string>
    <string name="market_keys_awesome_row">Currencies · AwesomeAPI</string>
    <string name="market_keys_awesome_without">Works without a key · with it, the chart shows the last hours</string>
    <string name="market_keys_awesome_intro">Currencies in reais work without any key: the current price and charts of the last few days, from AwesomeAPI and Frankfurter. With the AwesomeAPI key the chart also shows the last few hours and the last 24 hours.</string>
    <string name="market_keys_awesome_create">Free, up to 100,000 requests a month.</string>
    <string name="market_keys_awesome_copy">In your account, open API Keys and copy the key.</string>
