    <string name="blur_system_title">Android\'s blur</string>
    <string name="blur_system_on">Available on this device. Kiri uses it behind the drawer when it has no picture of the wallpaper, as with a live one.</string>
    <string name="blur_system_off">Not available right now. Either this device does not offer it to apps, or it is turned off by battery saving or by “Reduce transparency and blur”.</string>
    <string name="blur_system_old">Needs Android 12 or newer.</string>
    <string name="blur_copy_title">Kiri\'s own blur</string>
    <string name="blur_copy_ready">Kiri is reading the wallpaper and blurs its own copy: behind the drawer, widgets, menus and icons.</string>
    <string name="blur_copy_not_allowed">Kiri is not allowed to read the wallpaper yet. Allow it once and glass turns frosted behind the drawer, widgets, menus and icons.</string>
    <string name="blur_copy_animated">The wallpaper is a live one, so there is no picture to read. Only Android\'s blur can follow it; without it, glass keeps only its tint.</string>
    <string name="blur_copy_unreadable">Kiri is allowed to read the wallpaper, but the device did not hand it over.</string>
    <string name="blur_allow">Let Kiri read the wallpaper</string>
    <string name="blur_allow_summary">Opens the “access to all files” permission. Kiri only reads the wallpaper.</string>

