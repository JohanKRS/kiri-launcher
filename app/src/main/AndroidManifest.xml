<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- One APK for phones, tablets and TVs: nothing here may be required. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- Kiri's live wallpaper is for phones and tablets; TVs draw theirs on the home screen. -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <!-- Only Kiri's own widgets use the network (the market widget fetches prices). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the launcher see every app that has a launcher or TV launcher entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!--
            Home screens, to know what the Home button opens on a TV and whether Kiri can be it
            (see HomeButton), and the settings where the home screen is chosen.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.HOME_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" />
        </intent>
        <!-- The accessibility settings, to open the page that is really there (a TV's own one). -->
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_DETAILS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_TV_OEM_LINK" />
        </intent>
        <!-- Icon packs, so their icons can be chosen for an app. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <!-- Apps that give the market widget its prices (see SourceApps in core). -->
        <intent>
            <action android:name="io.github.johankrs.kiri.action.MARKET_SOURCE" />
        </intent>
        <!-- Apps that offer widgets, so every one of them can be listed and shown. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <!--
        The query above does not reach every app with widgets: APPWIDGET_UPDATE is a broadcast
        only the system may send, so Android leaves the receivers that wait for it out of what
        it lets an app see. An app with widgets and no icon of its own in the launcher (Samsung's
        Weather is one) would then be missing from the list of widgets. A launcher sees every
        app, as Android's own launcher does.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        Lets Kiri read the wallpaper, to blur its own copy of it behind glass: Android hands the
        wallpaper only to apps with access to all files. The person turns this on in settings;
        without it, glass is only tinted. Up to Android 12 the ordinary permission is enough.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Lets a TV show its own pictures, and those on a USB drive, to choose the wallpaper of its
        home screen from: most TVs have no gallery or file picker to ask instead. Asked for only
        there, when the person opens that list.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Lets a picture chosen in Kiri become the wallpaper, and travel with the home pages. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />

    <!--
        Lets the automatic backup, when it is on, still be made after the device restarts:
        Android keeps Kiri's job to wake it only for apps that may hear the device start.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lets a gesture pull down the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Lets the menu of an app ask Android to uninstall it (Android still asks to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner_lilac"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kiri">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">

            <!-- Offers Kiri as the home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!--
            How Kiri is opened like any app, on phones and on TVs: one entry per color of its
            icon, all opening MainActivity. Exactly one is on at a time; the person picks the
            color in Kiri's settings (see AppIcons). The home screen entry above never changes.
        -->
        <activity-alias
            android:name=".IconLilac"
            android:banner="@drawable/tv_banner_lilac"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lilac"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconMist"
            android:banner="@drawable/tv_banner_mist"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mist"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSmoke"
            android:banner="@drawable/tv_banner_smoke"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_smoke"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconNight"
            android:banner="@drawable/tv_banner_night"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_night"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconRose"
            android:banner="@drawable/tv_banner_rose"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rose"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBlue"
            android:banner="@drawable/tv_banner_blue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Where Android wakes Kiri to make the automatic backup (see AutoBackups). -->
        <service
            android:name=".AutoBackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Kiri's live wallpapers, drawn by Kiri; chosen in Kiri's wallpaper settings. -->
        <service
            android:name=".KiriLiveWallpaper"
            android:exported="true"
            android:label="@string/live_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/kiri_live_wallpaper" />
        </service>

        <!--
            Off until the person turns it on in Android's accessibility settings. It lets a
            gesture lock the screen and, on a TV, the Home button open Kiri where the TV's own
            home screen outranks it; it reads nothing on the screen. Disabled here, so Android
            lists it only while one of those is wanted (KiriAccessibilityService.offer).
        -->
        <service
            android:name=".KiriAccessibilityService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/kiri_accessibility" />
        </service>
    </application>

</manifest>
